<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net462;net480;net8.0</TargetFrameworks>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>ChriveSolutions.ZUGFeRD.PDF</PackageId>
    <PackageReadmeFile></PackageReadmeFile>
    <UserSecretsId>ceeaa3c6-7c48-4061-b8f6-da26a9de5879</UserSecretsId>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>True</IncludeSymbols>
	<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	<PublishRepositoryUrl>true</PublishRepositoryUrl>
	<EmbedUntrackedSources>true</EmbedUntrackedSources>
	<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>	
    <RootNamespace>s2industries.ZUGFeRD.PDF</RootNamespace>	
    <PackageReleaseNotes>See CHANGELOG.md in the repository.</PackageReleaseNotes>
    <AssemblyName>s2industries.ZUGFeRD.PDF</AssemblyName>
    <Description>PDF/A-3 embedding for the ZUGFeRD-csharp maintenance fork (original by Stephan Stapel, Apache-2.0). Maintained by chrive-solutions e.U. for its own products, without commitments to third parties. Same assembly name and namespaces as the original.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>ZUGFeRD.PDF.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\sRGB-IEC61966-2.1.icc" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\PdfMetadataTemplate-2.0.xml" />
    <EmbeddedResource Include="Resources\PdfMetadataTemplate-2.3.xml" />
    <EmbeddedResource Include="Resources\PdfMetadataTemplate-1.0.xml" />
    <EmbeddedResource Include="Resources\sRGB-IEC61966-2.1.icc" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharp-extended" Version="1.3.0" />
  </ItemGroup>

  <!-- Fork: the PDF package depends on this repository's core project, never on the original NuGet package. -->
  <ItemGroup>
    <ProjectReference Include="..\ZUGFeRD\ZUGFeRD.csproj" />
  </ItemGroup>

	<!-- netstandard: minimal & stabil -->
	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' &#xD;&#xA;                      Or '$(TargetFramework)' == 'netstandard2.1'">
		<PackageReference Include="System.Text.Encoding.CodePages" Version="4.7.1" />
	</ItemGroup>

	<!-- .NET Framework -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net462' &#xD;&#xA;                      Or '$(TargetFramework)' == 'net480'">
		<PackageReference Include="System.Text.Encoding.CodePages" Version="4.7.1" />
	</ItemGroup>

	<!-- .NET -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
	</ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'netstandard2.1' Or '$(TargetFramework)' == 'netstandard2.0'">
    <InternalsVisibleTo Include="ZUGFeRD.PDF.Test" PublicKey="" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net462' Or '$(TargetFramework)' == 'net480'">
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>
        ZUGFeRD.PDF.Test, </_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>